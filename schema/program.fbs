// Schemas for request/response representations used by the Program API.

namespace Cobbleware.Program;

table StartState {
    state_name:string (required);
    state:[ubyte] (required);
}

table StartStatesResponse {
    start_states:[StartState];
}

table StepRequest {
    puter_id:Common.UUID (required);
    state:[ubyte] (required);
    event:Events.Event (required);
}

table StepResponse {
    state:[ubyte] (required);
    effects:[Effects.Effect] (required);
}

table ErrorResponse {
    error:string (required);
}
