namespace Cobbleware.Common;

// Common Schemas

struct Vec3 {
    x:double;
    y:double;
    z:double;
}

struct Vec3i {
    x:int32;
    y:int32;
    z:int32;
}

struct ChunkPos {
    x:int32;
    z:int32;
}

enum Direction : ubyte {
  DOWN = 0,
  UP = 1,
  NORTH = 2,
  SOUTH = 3,
  WEST = 4,
  EAST = 5
}

table Identifier {
    ns:string;
    path:string;
}

struct UUID {
    high:long;
    low:long;
}