include "events.fbs";

namespace Cobbleware.Internal;

table EventSeq {
    puter_id: Common.UUID (required);
    initial_state:[ubyte] (required);
    events:[Events.Event] (required);
}

table EffectSeq {
    puter_id: Common.UUID (required);
    final_state:[ubyte] (required);
    effects:[Effects.Effect] (required);
}