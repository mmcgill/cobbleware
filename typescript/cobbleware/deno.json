{
  "name": "@cobbleware/core",
  "version": "0.0.2-alpha",
  "exports": {
    ".": "./src/mod.ts",
    "./internal": "./generated/internal_pb.ts"
  },
  "tasks": {
    "test": "deno test --no-prompt",
    "check": "deno check src/mod.ts tests/**/*.ts",
    "fmt": "deno fmt --ignore=generated",
    "generate": "deno run --allow-read --allow-write --allow-run scripts/generate.ts",
    "pack": "deno run --allow-read --allow-write --allow-run scripts/pack.ts"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve"
  }
}
